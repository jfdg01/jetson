# Python
.venv/
.venv-ft/
smolvlm_ft/
smolvlm_ft3/
smolvlm_ft4/
__pycache__/
.hist/
*.pyc
.pytest_cache/

# Stage 3 model artifacts — merged checkpoint + GGUF exports (multi-GB binaries,
# exceed GitHub's 100 MB per-file limit). Kept locally + on the Jetson; not committed.
*.gguf

# Datasets (COCO train2014, VisDrone, RefDrone cache) — tens of GB, not thesis source.
# Anchored to repo root so it does NOT swallow the grounding/data/ package.
/data/
/examples/

# Run outputs: training checkpoints under runs/ are multi-GB binaries, but the
# per-run PROVENANCE (manifest.json / run-card.md / results.json — the v2
# experiment-tracking record) must stay committed. Ignore everything in runs/
# except those text artifacts.
runners/runs/**
!runners/runs/**/
!runners/runs/**/manifest.json
!runners/runs/**/run-card.md
!runners/runs/**/results.json

# Same rule for per-experiment runs/ (bake-off arms write merged checkpoints of
# 1-6 GB per lr leg — 66 GB for one campaign). Provenance text + the per-epoch
# metric CSVs (train_loss.csv / eval_iou.csv, thesis content) stay committed.
# (Already-tracked files, e.g. whole-frame-resolution's runs/, are unaffected.)
experiments/*/runs/**
!experiments/*/runs/**/
!experiments/*/runs/**/manifest.json
!experiments/*/runs/**/run-card.md
!experiments/*/runs/**/results.json
!experiments/*/runs/**/*.csv
!experiments/*/runs/**/gt.jsonl

# Stray root runs/ — provenance belongs under runners/runs/ or experiments/*/runs/
# (co-located with its artifact). A bare /runs/ at repo root is always a cwd-relative
# manifest.write() leak from a driver launched here; never commit it. See manifest.write.
/runs/

# Secrets
.hugging-face-token

# Large binary footprint files — G2/G3 raw --no-mmap dumps are multi-GB binary blobs
# that exceed GitHub's 100 MB per-file limit. Keep them locally; don't commit.
# (G4/G5 footprint files are plain text at ~100-150 KB and are fine to commit.)
experiments/2026-06-14-gemma-family-sweep/raw/2026-06-14_gsweepG2_footprint.txt
experiments/2026-06-14-gemma-family-sweep/raw/2026-06-14_gsweepG3_footprint.txt

# Launcher runtime state (PID files) — noise next to the raw logs, never content
experiments/*/raw/*.pid

# OS / editor noise
.DS_Store
*.swp
*~

# Stray hardware dumps (e.g. eeprom reads) — not thesis content
eeprom.bin

# Auto-continuation runtime state (logs, sentinels, locks) — mechanism in scripts/ is committed
.auto-continue/
.claude/loop*
.claude/settings.local.json
runners/sitl/external/
runners/_gz_feed.log
.claude/autoresearch.log
.claude/autoresearch-logs/
.claude/autoresearch.STOP
.claude/autoresearch.deadline

# showcase clips are large; stills + README are tracked
showcase/**/*.mp4
